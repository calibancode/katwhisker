<component type="desktop-application">
  <id>io.github.calibancode.katwhisker</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Katwhisker</name>
  <summary>Listen to internet radio</summary>
  <developer id="io.github.calibancode">
    <name>calibancode</name>
  </developer>
  <description>
    <p>
      A small web radio player for Plasma, with stations from the radio-browser.info directory.
    </p>
    <ul>
      <li>Search stations, browse by tag, and keep favorites</li>
      <li>Shows the current song where the station provides it, and keeps a history of songs you've heard</li>
      <li>Works with media keys and Plasma's media controls</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.calibancode.katwhisker.desktop</launchable>
  <url type="homepage">https://github.com/calibancode/katwhisker</url>
  <url type="bugtracker">https://github.com/calibancode/katwhisker/issues</url>
  <url type="vcs-browser">https://github.com/calibancode/katwhisker</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <provides>
    <binary>katwhisker</binary>
  </provides>
  <requires>
    <internet>always</internet>
  </requires>
  <screenshots>
    <screenshot type="default">
      <caption>Browsing stations while one plays</caption>
      <image>https://raw.githubusercontent.com/calibancode/katwhisker/v0.2.0/screenshots/main.webp</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-10-08">
      <description>
        <ul>
          <li>New Songs tab: a searchable history of the songs you've heard, to copy their titles later</li>
          <li>Song recording has been removed</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-09-29">
      <description>
        <p>Bug fixes for recordings:</p>
        <ul>
          <li>Exporting saves the song you picked, even if new songs arrive while the dialog is open</li>
          <li>A failed export no longer deletes the file it was replacing</li>
          <li>Only one copy of the app runs, so copies can't delete each other's recordings</li>
          <li>Fixed a possible crash on quit and on malformed streams</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-29"/>
  </releases>
</component>
